# Tender AI backend URL.
# Office PC pushing to PRODUCTION: use the Railway URL, e.g.
#   TENDER_AI_BASE_URL=https://tender-ai-production-5a7d.up.railway.app
# Local development only: http://127.0.0.1:8000
TENDER_AI_BASE_URL=https://tender-ai-production-5a7d.up.railway.app

# Must EXACTLY match LOCAL_AGENT_API_KEY set on the Railway backend.
LOCAL_AGENT_API_KEY=change-me-to-a-long-random-secret

# Browser profile is kept locally so GeM cookies/CSRF/session can be reused.
BROWSER_PROFILE_DIR=.browser-profile
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSER_CHANNEL=msedge

# Scan behavior.
MAX_RESULTS_PER_KEYWORD=50
KEYWORD_DELAY_SECONDS=2
PAGE_DELAY_SECONDS=0.5

# Date mode:
# date = keep only bids whose GeM start date equals the dashboard scan date
# all = send all rows returned by GeM search up to MAX_RESULTS_PER_KEYWORD
SEARCH_DATE_MODE=date
SEARCH_TARGET_DATE=
SEARCH_DATE_FROM=
SEARCH_DATE_TO=

# If true, agent prints discoveries but does not send them to Tender AI.
DRY_RUN=true
