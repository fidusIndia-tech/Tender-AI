{
  "manifest_version": 3,
  "name": "GeM BidPlus Autofill",
  "version": "1.0.0",
  "description": "Autofills Bid/RA Status and bid number on GeM all-bids pages opened from the tender app.",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1:8001/*",
        "http://localhost:8000/*",
        "http://localhost:8001/*",
        "https://tender-ai-production-5a7d.up.railway.app/*",
        "https://*.up.railway.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://bidplus.gem.gov.in/all-bids*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://bidplus.gem.gov.in/*"
  ]
}
